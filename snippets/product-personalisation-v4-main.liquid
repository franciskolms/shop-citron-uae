    <div class="close-confirm-text">The personalisation won't be applied<br>if you close this window.</div> <!-- The personalisation won't be applied if you close this window. -->
    <div class="close-modal-btn-wrap">
        <button class="button button--secondary" id="confirmPersClose">Yes, close</button> <!-- Yes, close -->
