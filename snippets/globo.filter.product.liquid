    a.spf-product-extra-swatches {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        text-decoration: none;

        background: #F6F6F6;
        position: absolute;
        z-index: 2;
        left: 0;
        bottom: 2rem;
        font-weight: 600;
        font-size: 1.3rem;
        width: 2.8rem;
        height: 2.8rem;
    }

    a.spf-product-extra-swatches:visited,
    a.spf-product-extra-swatches {
        color: #333333!important;
    }

    .gf-block-scroll {
        overflow: hidden;
        padding-right: 0 !important;
    }

    .gf-refine-toggle-mobile .fa.fa-tasks {
        margin-left: 1rem;
    }

    .globo-selected-items-wrapper.rounded .selected-item span.gf-clear {
        width: 16px !important;
        height: 16px !important;
        flex: 0 0 16px !important;
    }

    /* clear default button styles */
    button.clear-refinements.visible-xs {
        background: none !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
        margin-bottom: 1.5rem !important;
        font-size: 1.25rem !important;
        color: #333333 !important;
        
    }

    @media (max-width: 768px) {
        .spf-product-extra-swatches.plus-7 {
            display: none !important;
        }
    }

    @media (min-width: 768px) {
        .spf-product-extra-swatches.plus-5 {
            display: none !important;
        }
    }

