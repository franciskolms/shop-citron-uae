{% assign cust_img_max_height = 625 %}

<style>
.cust-modal-wrapper .tingle-modal-box {
    width:100%;
    height:100%;
    }

@media (max-width: 768px) {
    .cust-modal-wrapper .tingle-modal-box {
        padding-top: 2rem;
        overflow: hidden;
    }
}

.cust-modal-wrapper.tingle-modal--overflow {
padding-top:0;
}

@media (max-width: 768px) {
    .cust-modal-wrapper.tingle-modal--overflow {
        padding-top: 8vh;
    }
}

.cust-modal-wrapper .tingle-modal-box__content {
padding:0;
}

@media (max-width: 768px) {
    .cust-modal-wrapper {
        max-height:111vh;
    }
}

#customiseModal {
    display: flex;
    flex-direction: row;
}

@media (max-width: 768px) {
    #customiseModal {
        flex-direction: column;
    }
}

.image-pane-wrapper {
    position: relative;
    height: 100vh;
    background: #F6F6F6;
}

@media (min-height: {{ cust_img_max_height }}px) and (min-width: 768px) {
    .image-pane-wrapper {
        height: {{ cust_img_max_height }}px!important;
    }
}

@media (max-width: 768px) {
    .image-pane-wrapper {
        height: auto;
        width: 100vw;
    }
}

.info-pane-wrapper,
.step-two-pane-wrapper {
    position:relative;
    padding: 2rem 3rem;
    {% comment %} height: 100%; {% endcomment %}
    height: 100vh;
    align-self: flex-start;
}

@media (max-width: 768px) {
    .info-pane-wrapper,
    .step-two-pane-wrapper {
        padding: 1rem 3rem 2rem 3rem;
    }
}

.cust-top-title-wrap {
    display: flex;
    height: 4rem;
    column-gap: 0.8rem;
    {% comment %} margin-left: 3.7rem; {% endcomment %}
}

@media (max-width: 768px) {
    .cust-top-title-wrap {
        height: 2.25rem;
        {% comment %} margin-left: 2.5rem; {% endcomment %}
    }
}

{% comment %} .cust-lottie-modal {
    position: absolute;
    height: 4.7rem;
    margin-left: -5.6rem;
    filter: invert(0.25);
}

@media (max-width: 768px) {
    .cust-lottie-modal {
        flex:1;
        margin-top: -0.9rem;
        left: 2.5rem;
    }
} {% endcomment %}

.cust-top-title {
    font-family: 'TiemposHeadline';
    font-weight: 400;
    font-size: 2.5rem;
}

@media (max-width: 768px) {
    .cust-top-title {
        align-self: center;
        margin-bottom: -0.5rem;
        font-size: 2rem;
        flex: 10;
    }
}

.cust-product-title {
    font-size: 1.5rem;
    font-weight: 400;
    padding: 1.5rem 0 1rem 0;
}

.cust-product-desc,
.cust-product-desc-title {
    font-size: 1.25rem;
}

.cust-product-desc-title {
    font-weight: 500;
}

.cust-product-desc {
    margin-bottom: 1rem;
}

img#activeThemeImage {
    height: 100%;
    max-height: {{ cust_img_max_height }}px;
}

@media (max-width: 768px) {
    #activeThemeImage {
        width: 100%;
    }
}

#imposedPatches {
    position: absolute;
    display: flex;
    justify-content: center;
    width: 100%;
    top: calc(1vh * {{ product.metafields.custom.product_customisation.value.area_rectangle_y_position }});
    margin-left: {{ product.metafields.custom.product_customisation.value.area_rectangle_x_position }}%;
}

@media (min-height: {{ cust_img_max_height }}px) and (min-width: 768px) {
    #imposedPatches {
        top: calc({{ cust_img_max_height }}px * {{ product.metafields.custom.product_customisation.value.area_rectangle_y_position }} / 100)!important;
    }
}

@media (max-width: 768px) {
    #imposedPatches {
        font-size: 5vw;
        top: calc(0.65vw * {{ product.metafields.custom.product_customisation.value.area_rectangle_y_position }});
    }
}

.imposed-patch-wrap {
    position:relative;
}

img.imposed-patch {
    width:calc(1vh * {{ product.metafields.custom.product_customisation.value.area_rectangle_height }});
    margin: 0 -0.25rem;
}

@media (min-height: {{ cust_img_max_height }}px) and (min-width: 768px) {
    img.imposed-patch {
        width:calc({{ cust_img_max_height }}px * {{ product.metafields.custom.product_customisation.value.area_rectangle_height }} / 100)!important;
    }
}

@media (max-width: 768px) {
    img.imposed-patch {
        width:calc(0.3vh * {{ product.metafields.custom.product_customisation.value.area_rectangle_height }});
    }
}

span.material-icons.delete-patch-btn {
    position: absolute;
    left: 50%;
    transform: translate(-50%, 0);
    top: calc(-0.7vh * {{ product.metafields.custom.product_customisation.value.area_rectangle_height }});
    font-size: 3rem;
    cursor:pointer;
    color: white;
    border: 2px solid #ff8a8a;
    border-radius: 50%;

    opacity:0;
    pointer-events:none;
}

@media (max-width: 768px) {
    span.material-icons.delete-patch-btn {
        top: calc(-0.4vh * {{ product.metafields.custom.product_customisation.value.area_rectangle_height }});
    }
}

span.material-icons.delete-patch-btn.active {
    opacity:1;
    pointer-events:all;
}

#custThemeOptions {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-bottom: 2rem;
    grid-column-gap: 1rem;
}

#custThemeOptions img {
    width:100%;
    border: 1.5px solid white;
    padding: 0.25rem;
    transition:.4s;
    cursor: pointer;
}

#custThemeOptions img:hover {
    border-color: #9ea3926e;
    transition:.4s;
}

#custThemeOptions img.selected {
    border: 1.5px solid #9ea392;
    transition:.4s;
}

@media (max-height: 1500px) {
    #custThemeOptions {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-height: 900px) {
    #custThemeOptions {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (max-height: 600px) {
    #custThemeOptions {
        grid-template-columns: repeat(5, 1fr);
    }
}

@media (max-width: 540px) {
    .tingle-modal {
        height: 111vh;
    }
}

.material-icons.close {
    position: absolute;
    color: #4D4D4D;
    right: 3rem;
    top: 3rem;
    font-size: 2.5rem;
    border: 1px solid black;
    border-radius: 50%;
    padding: 0.5rem;
    cursor:pointer;
    transition:.4s;
}

.material-icons.close:hover {
    background: #676767;
    color: white;
    border: 1px solid white;
    transition:.4s;
}

@media (max-width: 768px) {
    .material-icons.close {
        font-size: 2rem;
        right: 2rem;
        top: 2rem;
    }
}

#summarySection {
    position: absolute;
    bottom: 0;
    width: 100%;
    margin-left: -3rem;
    padding: 2rem 3rem;
    pointer-events:none;
}

@media (max-width: 768px) {
    #summarySection {
        position: fixed;
        bottom: 12vh;
    }
}

.summary-btn-wrap {
    display: flex;
    pointer-events: all;
}



button.cust-summary, 
button.cust-continue,
button.tab-letters,
button.tab-icons
{
    border-radius:21px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    border: 0;
    padding: 0 3rem;
    cursor: pointer;
    font: inherit;
    text-decoration: none;
    appearance:none;
    font-size: 1.5rem;
    letter-spacing: 0.1rem;
    line-height: calc(1 + 0.2 / var(--font-body-scale));
    width:100%;
    min-width: calc(12rem + var(--buttons-border-width) * 2);
    min-height: calc(4.5rem + var(--buttons-border-width) * 2);
    font-weight:400;
    cursor:pointer;
    transform: translateY(0);
}

button.cust-summary {
    color:#4D4D4D;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

button.cust-summary::before {
    font-family: "Material Icons";
    content:"expand_less";
    font-size:2rem;
    padding-right:1rem;
}

button.cust-continue {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    background:#9EA392;
    color:white;
}

button.cust-continue.disabled {
    opacity:.5;
    pointer-events:none;
}

#addToCartBtn .loading-overlay__spinner {
    filter: invert(1);
}

.summary-info-wrap {
    padding: 2rem 2rem 4rem 2rem;
    background: white;
    margin-top: 1rem;
    margin-bottom: -2rem;
    border-top-right-radius: 21px;
    border-top-left-radius: 21px;
    box-shadow: 0px 0px 5px 0px #00000057;
    opacity:0;
    pointer-events:none;
    transform: translateY(10px);
    transition:.4s;
}

.summary-info-wrap.open {
    opacity:1;
    pointer-events:all;
    transform: translateY(0px);
    transition:.4s;
}

.summary-row {
    display: flex;
    font-size: 1.25rem;
    font-weight: 400;
    justify-content: space-between;
}

.summary-row .item-title {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
}

.summary-row.total {
    border-top: 1px solid #d6d6d6;
    padding-top: 1rem;
    margin-top: 1rem;
}

#stepOneSection {
    opacity:0;
    transition:.4s;
    transform: translateX(-20px);
    pointer-events:none;
}

#stepTwoSection {
    position: absolute;
    padding: 0 3rem;
    top: 2rem;
    width: 100%;
    margin-left: -3rem;
    opacity:0;
    transition:.4s;
    transform: translateX(20px);
    pointer-events:none;
}

#stepOneSection.current,
#stepTwoSection.current {
    opacity:1;
    transition:.4s;
    transform: translateX(0px);
    pointer-events:all;
}

.step-nav {
    display: flex;
    column-gap: 1rem;
    align-items: center;
    font-weight: 400;
}

#backToStepOneBtn {
    cursor:pointer;
}

.patch-tabs-wrap {
    display:flex;
    padding-top: 1rem;
}

button.tab-letters,
button.tab-icons {
    color:#4D4D4D;
    min-height: calc(3.5rem + var(--buttons-border-width) * 2);
}

button.tab-letters {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

button.tab-icons {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

button.tab-letters.active,
button.tab-icons.active {
    background:#4D4D4D;
    color:white;
}

.patch-selection-section {
    position: absolute;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-gap: 1rem;
    width: calc(100% - 6rem);
    opacity: 0;
    transition:.4s;
    margin-top:2rem;
    overflow-y: scroll;
    max-height: 60vh;
    padding-bottom: 7rem;
    pointer-events: none;
}

#allAvailableIcons {
    margin-top: -4rem;
}

#stepTwoSection.current .patch-selection-section.active {
    opacity: 1;
    transition:.4s;
    z-index: 1;
    pointer-events: all;
}

@media (max-width: 768px) {
    .patch-selection-section {
        max-height: 250px;
    }
}

img.patch-img-small {
    width: 100%;
    height: 100%;
}

.cust-theme-opt-wrap.not-available,
img.patch-img-small.not-available {
    opacity: .25;
    pointer-events:none;
}

.letter-search-wrap {
    margin-top: 2rem;
    transition:.4s;
}

.letter-search-wrap.inactive {
    opacity:0;
    pointer-events:none;
    transition:.2s;
}

.cust-info-img-bottom {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 0);
    width: 100vw;
    font-size: 1.1rem;
    font-weight: 400;
    text-align: center;
    margin-bottom: 0.5rem;
    opacity:0;
}

.cust-info-img-bottom::before {
    font-family: "Material Icons";
    content: "info";
    font-size: 1.4rem;
    position: absolute;
    margin-left: -2rem;
    margin-top: -0.25rem;
    color: #9EA392;
}

.cust-info-img-top {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, 0);
    width: 100vw;
    font-size: 1.1rem;
    font-weight: 400;
    text-align: center;
    margin-top: 0.5rem;
    opacity:0;
}

.cust-info-img-top::before {
    font-family: "Material Icons";
    content: "info";
    font-size: 1.4rem;
    position: absolute;
    margin-left: -2rem;
    margin-top: -0.25rem;
    color: #9EA392;
}

.background-extension {
    display:none;
}

@media (min-width: 768px) {
    .background-extension {
        display: block!important;
        position: absolute;
        background: #F6F6F6;
        width: 100%;
        height: 200%;
        z-index: -10;
    }
}

.close-modal-btn-wrap {
    display: flex;
    column-gap: 1rem;
    justify-content: center;
}

.close-confirm-text {
    font-family: 'TiemposHeadline';
    font-size: 2rem;
    text-align: center;
    padding-bottom: 2rem;
}

</style>

<div id="customiseCloseModal">
    <div class="close-confirm-text">
        The customisations won't be applied<br>if you close this window.
    </div>
    <div class="close-modal-btn-wrap">
        <button class="button button--secondary" id="confirmCustClose">Yes, close</button>
        <button class="button button--primary" id="rejectCustClose">No, stay here</button>
    </div>
</div>

<div id="customiseModal">
    <div class="image-pane-wrapper">
        <div class="cust-info-img-top">Max number of patches for this product is {{ product.metafields.custom.product_customisation.value.maximum_number_of_patches }}</div>
        <div class="background-extension">.</div>
        <span class="material-icons close customisation-close-btn">close</span>
        <div id="imposedPatches"></div>
        <img src="" id="activeThemeImage">
        <div class="cust-info-img-bottom">You can remove a letter or icon by clicking on it</div>
      </div>
      <div class="info-pane-wrapper">
        <div id="stepOneSection" class="current">
            <div class="cust-top-title-wrap">
                {% comment %} <span class="cust-lottie-modal">
                    <lottie-player src="{{ 'lottie-letters.json' | asset_url }}"  background="transparent" speed="1" loop autoplay></lottie-player>
                </span> {% endcomment %}
                <div class="cust-top-title">Customise</div>
            </div>
            <div class="cust-product-title"></div>
            <div class="cust-product-desc-title">
                {{ product.metafields.custom.product_customisation.value.description_title }}
            </div>
            <div class="cust-product-desc">
                {{ product.metafields.custom.product_customisation.value.description_text }}
            </div>
            <div id="custThemeOptions"></div>
        </div>
        <div id="stepTwoSection">
            <div class="step-nav">
                <span class="material-icons" id="backToStepOneBtn">arrow_back_ios</span>
                <div class="step-nav-text">Back To Theme Selection</div>
            </div>
            <div class="patch-tabs-wrap">
                {% comment %}<button class="tab-btn tab-letters active">Letters (AED5)</button>
                <button class="tab-btn tab-icons">Icons (AED5)</button> {% endcomment %}
                <button class="tab-btn tab-letters active">Letters</button>
                <button class="tab-btn tab-icons">Icons</button> 
            </div>
            
            <div class="letter-search-wrap active field">
                <input 
                    type="text" 
                    placeholder="Type a letter or word" 
                    class="field__input" 
                    id="letterSearch" 
                    maxlength="30"
                    value="" 
                >
                <label 
                    class="field__label" 
                    for="letterSearch"
                >Type a letter or word</label>
            </div>

            <div id="allAvailableLetters" class="patch-selection-section active">
                <!-- Letters get rendered here by JS -->
            </div>
            <div id="allAvailableIcons" class="patch-selection-section">
                <!-- Icons get rendered here by JS -->
            </div>
        </div>
        <div id="summarySection">
            <div class="summary-info-wrap"></div>
            <div class="summary-btn-wrap">
                <button id="summaryBtn" class="cust-summary">Summary</button>
                <button id="nextStepBtn" class="cust-continue">Continue</button>
                <button id="addToCartBtn" class="cust-continue" style="display:none">
                    <span>Add To Cart</span>

                    <div class="loading-overlay__spinner hidden">
                        <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                          <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                        </svg>
                      </div>

                </button>
            </div>
        </div>
      </div>
</div>

<script src="{{ 'tingle.min.js' | asset_url }}"></script>

<script>
    //////////////////////////////////////////////////
    // Modal setup (unchanged)
    //////////////////////////////////////////////////
    var customiseModal = new tingle.modal({
      closeMethods: ['overlay', 'escape'],
      cssClass: ['cust-modal-wrapper'],
    });
    
    var custConfirmationModal = new tingle.modal({
      closeMethods: ['overlay', 'escape'],
      cssClass: ['cust-confirmation-modal-wrapper'],
    });
    
    customiseModal.setContent(document.getElementById('customiseModal'));
    custConfirmationModal.setContent(document.getElementById('customiseCloseModal'));
    
    document.querySelector('#confirmCustClose').addEventListener('click', () => {
      custConfirmationModal.close();
      customiseModal.close();
    });
    
    document.querySelector('#rejectCustClose').addEventListener('click', () => {
      custConfirmationModal.close();
    });
    
    document.querySelector('.customisation-close-btn').addEventListener('click', () => {
      custConfirmationModal.open();
    });
    
    //////////////////////////////////////////////////
    // THEME ≙ VARIANT (new): build from product variants
    //////////////////////////////////////////////////
    const PRODUCT_TITLE = {{ product.title | json }};
    
    let availableVariantsArray = [
      {% for v in product.variants %}
      {
        id: {{ v.id }},
        available: {{ v.available }},
        variantTitle: {{ v.title | json }},
        // price in cents
        price: {{ v.price }},
        // image priority: variant metafield → variant image → product image
        image: "{% if v.metafields.custom.customisation_image != blank %}{{ v.metafields.custom.customisation_image | image_url: width: 900 }}{% elsif v.featured_image %}{{ v.featured_image | img_url: '900x' }}{% else %}{{ product.featured_image | img_url: '900x' }}{% endif %}"
      },
      {% endfor %}
    ];
    
    function computeDisplayTitle(variant) {
      if (!variant) return PRODUCT_TITLE;
      return (variant.variantTitle && variant.variantTitle !== 'Default Title')
        ? `${PRODUCT_TITLE} — ${variant.variantTitle}`
        : PRODUCT_TITLE;
    }
    
    //////////////////////////////////////////////////
    // Patches (unchanged data build)
    //////////////////////////////////////////////////
    let availablePatchesArray = {
      letters: [
        {% for collection in product.metafields.custom.product_customisation.value.letters_collections.value %}
        {% paginate collections[collection.handle].products by 1000 %}
        {
          patches: [
            {% for letter_patch in collections[collection.handle].products %}
            {
              title: {{ letter_patch.title | json }},
              id: {% if letter_patch.first_available_variant.id != blank %}{{ letter_patch.first_available_variant.id }}{% else %}""{% endif %},
              image: "{{ letter_patch.featured_image | img_url: '100x' }}",
              price: {{ letter_patch.price }},
              available: {{ letter_patch.available }},
              value: {{ letter_patch.metafields.custom.patch_label_for_customisation | json }}
            },
            {% endfor %}
          ],
          title: {{ collection.title | json }}
        },
        {% endpaginate %}
        {% endfor %}
      ],
      icons: [
        {% for collection in product.metafields.custom.product_customisation.value.icons_collections.value %}
        {% paginate collections[collection.handle].products by 1000 %}
        {
          patches: [
            {% for icon_patch in collections[collection.handle].products %}
            {
              title: {{ icon_patch.title | json }},
              id: {% if icon_patch.first_available_variant.id != blank %}{{ icon_patch.first_available_variant.id }}{% else %}""{% endif %},
              image: "{{ icon_patch.featured_image | img_url: '100x' }}",
              price: {{ icon_patch.price }},
              available: {{ icon_patch.available }}
            },
            {% endfor %}
          ],
          title: {{ collection.title | json }}
        },
        {% endpaginate %}
        {% endfor %}
      ]
    };
    
    //////////////////////////////////////////////////
    // Helpers
    //////////////////////////////////////////////////
    Array.prototype.remove = function (from, to) {
      var rest = this.slice((to || from) + 1 || this.length);
      this.length = from < 0 ? this.length + from : from;
      return this.push.apply(this, rest);
    };
    
    function insertAfter(referenceNode, newNode) {
      referenceNode.parentNode.insertBefore(newNode, referenceNode.nextSibling);
    }
    
    function updateDisplayedTheme(image) {
      document.getElementById('activeThemeImage').src = image || "";
    }
    
    function getCurrentVariantIdFromForm() {
      // Dawn & most themes keep current variant id in the product form input[name="id"]
      const idInput =
        document.querySelector('form[action="/cart/add"] input[name="id"]') ||
        document.querySelector('form[id^="product-form"] input[name="id"]') ||
        document.querySelector('product-form form input[name="id"]');
    
      if (idInput && idInput.value) return Number(idInput.value);
      return Number({{ product.selected_or_first_available_variant.id }});
    }
    
    //////////////////////////////////////////////////
    // ProductState (tweaked to use VARIANT as theme)
    //////////////////////////////////////////////////
    let ProductState = {
      theme: {}, // now holds the ACTIVE VARIANT object
      patches: [],
      stateId: Math.floor(Date.now() / 1000),
      position: {
        size: {{ product.metafields.custom.product_customisation.value.area_rectangle_height }},
        x: {{ product.metafields.custom.product_customisation.value.area_rectangle_x_position }},
        y: {{ product.metafields.custom.product_customisation.value.area_rectangle_y_position }}
      },
    
      initThemeByVariantId(variantId) {
        this.theme = availableVariantsArray.find(v => v.id === Number(variantId)) || availableVariantsArray[0];
    
        // reset UI summary region
        const summary = document.querySelector('.summary-info-wrap');
        summary.innerHTML = `
          <div class="summary-row theme">
            <div class="item-title">${computeDisplayTitle(this.theme)}</div>
            <div>${this.formatPrice(this.theme.price)}</div>
          </div>
        `;
    
        // set modal product title and hero image
        document.querySelector('.cust-product-title').textContent = computeDisplayTitle(this.theme);
        updateDisplayedTheme(this.theme.image);
    
        this.renderPriceTotal();
      },
    
      updateTheme(targetVariant) {
        this.theme = targetVariant;
        document.querySelector('.summary-row.theme').innerHTML = `
          <div class="item-title">${computeDisplayTitle(this.theme)}</div>
          <div>${this.formatPrice(this.theme.price)}</div>
        `;
        document.querySelector('.cust-product-title').textContent = computeDisplayTitle(this.theme);
        updateDisplayedTheme(this.theme.image);
        this.renderPriceTotal();
      },
    
      addPatch(targetPatch) {
        this.patches.push(targetPatch);
        this.renderProductState();
        document.querySelector('.cust-info-img-bottom').style.opacity = 1;
      },
    
      removePatch(patchIndex) {
        this.patches.remove(patchIndex);
        this.renderProductState();
      },
    
      renderProductState() {
        // imposed patches on image
        document.getElementById('imposedPatches').innerHTML = this.patches.map((patch, index) => `
          <div class="imposed-patch-wrap">
            <span class="material-icons delete-patch-btn" data-patch-index=${index}>cancel</span>
            <img src="${patch.image}" data-patch-index=${index} class="imposed-patch">
          </div>
        `).join('');
    
        // click → reveal delete button
        document.querySelectorAll('.imposed-patch').forEach(patch => {
          patch.addEventListener('click', (e) => {
            document.querySelectorAll('.delete-patch-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.delete-patch-btn')[e.target.dataset.patchIndex].classList.add('active');
          });
        });
    
        // delete buttons
        document.querySelectorAll('.delete-patch-btn').forEach((btn, index) => {
          btn.addEventListener('click', () => this.removePatch(index));
        });
    
        // summary rows for patches
        document.querySelectorAll('.summary-row.patch').forEach(row => row.remove());
        [...this.patches].reverse().forEach(patch => {
          let el = document.createElement('div');
          el.className = 'summary-row patch';
          el.innerHTML = `<div class="item-title">${patch.title}</div><div>${this.formatPrice(patch.price)}</div>`;
          insertAfter(document.querySelector('.summary-row.theme'), el);
        });
    
        // total
        if (document.querySelector('.summary-row.total')) document.querySelector('.summary-row.total').remove();
        this.renderPriceTotal();
      },
    
      renderPriceTotal() {
        let totalPrice = this.theme.price || 0;
        this.patches.forEach(p => totalPrice += p.price);
        let total = document.createElement('div');
        total.className = 'summary-row total';
        total.innerHTML = `<div class="item-title">Total</div><div>${this.formatPrice(totalPrice)}</div>`;
        document.querySelector('.summary-info-wrap').append(total);
      },
    
      formatPrice(price) {
        // keep AED for consistency with your current UI
        let regex = /^-?\d+$/;
        if (regex.test(price)) {
          return "AED" + (parseInt(price, 10) / 100).toFixed(2);
        }
        return "AED0.00";
      },
    
      hasSpaceForNewPatch() {
        return this.patches.length < Number({{ product.metafields.custom.product_customisation.value.maximum_number_of_patches }});
      }
    };

    // If the shopper changes variants on the PDP while the modal is open (or before opening),
    // keep the modal’s “theme” (active variant) in sync.
    document.addEventListener('change', (e) => {
      const isVariantIdInput =
        e.target.matches('form[action="/cart/add"] input[name="id"]') ||
        e.target.matches('form[id^="product-form"] input[name="id"]') ||
        e.target.matches('product-form form input[name="id"]');

      if (!isVariantIdInput) return;

      const newId = Number(e.target.value);
      const nextVariant = availableVariantsArray.find(v => v.id === newId);
      if (nextVariant) {
        ProductState.updateTheme(nextVariant); // updates title, price, and image
      }
    });
    
    //////////////////////////////////////////////////
    // UI: we start on STEP TWO (patch selection)
    //////////////////////////////////////////////////
    function showStepTwoOnly() {
      const stepOne = document.getElementById('stepOneSection');
      const stepTwo = document.getElementById('stepTwoSection');
      stepOne && stepOne.classList.remove('current');
      stepTwo && stepTwo.classList.add('current');
    
      const nextBtn = document.getElementById('nextStepBtn');
      const addBtn  = document.getElementById('addToCartBtn');
      if (nextBtn) nextBtn.style.display = 'none';
      if (addBtn)  addBtn.style.display  = 'inline-flex';
    
      const stepNav = document.querySelector('.step-nav');
      if (stepNav) stepNav.style.display = 'none'; // hide "Back To Theme Selection"
    }
    
    //////////////////////////////////////////////////
    // Letters / Icons tabs (unchanged)
    //////////////////////////////////////////////////
    document.querySelector('.tab-letters').addEventListener('click', (e) => {
      e.target.classList.add('active');
      document.querySelector('.tab-icons').classList.remove('active');
      document.getElementById('allAvailableLetters').classList.add('active');
      document.getElementById('allAvailableIcons').classList.remove('active');
      document.querySelector('.letter-search-wrap').classList.remove('inactive');
    });
    
    document.querySelector('.tab-icons').addEventListener('click', (e) => {
      e.target.classList.add('active');
      document.querySelector('.tab-letters').classList.remove('active');
      document.getElementById('allAvailableIcons').classList.add('active');
      document.getElementById('allAvailableLetters').classList.remove('active');
      document.querySelector('.letter-search-wrap').classList.add('inactive');
    });
    
    //////////////////////////////////////////////////
    // Render available patches (unchanged)
    //////////////////////////////////////////////////
    function addAllLetterPatchesToDOM() {
      const wrap = document.getElementById('allAvailableLetters');
      wrap.innerHTML = "";
      availablePatchesArray.letters.forEach(category => {
        wrap.innerHTML += Object.values(category.patches).map(patch => `
          <div class="patch-wrapepr">
            <img
              src="${patch.image}"
              data-patch-id="${patch.id}"
              data-patch-type="letters"
              class="patch-img-small ${patch.available ? "" : "not-available"}">
          </div>
        `).join('');
      });
    }
    
    function addAllIconPatchesToDOM() {
      const wrap = document.getElementById('allAvailableIcons');
      wrap.innerHTML = "";
      availablePatchesArray.icons.forEach(category => {
        wrap.innerHTML += Object.values(category.patches).map(patch => `
          <div class="patch-wrapepr">
            <img
              src="${patch.image}"
              data-patch-id="${patch.id}"
              data-patch-type="icons"
              class="patch-img-small">
          </div>
        `).join('');
      });
    }
    
    addAllLetterPatchesToDOM();
    addAllIconPatchesToDOM();
    
    //////////////////////////////////////////////////
    // Summary toggle (unchanged)
    //////////////////////////////////////////////////
    document.getElementById('summaryBtn').addEventListener('click', () => {
      document.querySelector('.summary-info-wrap').classList.toggle('open');
    });
    
    //////////////////////////////////////////////////
    // Add To Cart (updated: use variant id)
    //////////////////////////////////////////////////
    document.getElementById('addToCartBtn').addEventListener('click', () => {
      document.querySelector('#addToCartBtn span').textContent = "";
      document.querySelector('#addToCartBtn .loading-overlay__spinner').classList.remove('hidden');
      document.getElementById('addToCartBtn').classList.add('disabled');
    
      // persist customisation locally
      let currentStorage = [];
      if (localStorage.getItem('productWithPatches')) {
        currentStorage = JSON.parse(localStorage.getItem('productWithPatches'));
        currentStorage.push(ProductState);
        localStorage.setItem('productWithPatches', JSON.stringify(currentStorage));
      } else {
        localStorage.setItem('productWithPatches', JSON.stringify([ProductState]));
      }
    
      // build cart payload
      let addToCartData = { items: [] };
      let listOfPatches = JSON.stringify(ProductState.patches.map((p, i) => `(${i + 1}) ${p.title}`)).replace(/"|\[|\]/g, "");
    
      // add base product (active variant)
      addToCartData.items.push({
        id: ProductState.theme.id, // <-- variant id
        quantity: 1,
        properties: {
          "CustomisationID": ProductState.stateId,
          "Patches": listOfPatches
        }
      });
    
      // add patches
      ProductState.patches.forEach(patch => {
        addToCartData.items.push({
          id: patch.id,
          quantity: 1
        });
      });
    
      // merge duplicate patch lines into quantity
      addToCartData.items.forEach((item, index) => {
        let dup = addToCartData.items.findIndex(p => p.id === item.id);
        if (dup !== index) {
          addToCartData.items[dup].quantity += item.quantity;
          addToCartData.items.splice(index, 1);
        }
      });
      // (double-run kept as you had it, to guard edge ordering)
      addToCartData.items.forEach((item, index) => {
        let dup = addToCartData.items.findIndex(p => p.id === item.id);
        if (dup !== index) {
          addToCartData.items[dup].quantity += item.quantity;
          addToCartData.items.splice(index, 1);
        }
      });
    
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(addToCartData)
      })
        .then(response => {
          window.location = "/cart";
          return response.json();
        })
        .catch((error) => {
          console.error('Error:', error);
        });
    });
    
    //////////////////////////////////////////////////
    // Patch selection: add listeners (unchanged)
    //////////////////////////////////////////////////
    function addPatchEventListeners() {
      document.querySelectorAll('.patch-img-small').forEach((patch) => {
        patch.addEventListener('click', () => {
          let clickedPatch;
    
          if (ProductState.hasSpaceForNewPatch()) {
            availablePatchesArray.letters.forEach((category) => {
              if (category.patches.find(p => p.id === parseInt(patch.dataset.patchId))) {
                clickedPatch = category.patches.find(p => p.id === parseInt(patch.dataset.patchId));
              }
            });
            availablePatchesArray.icons.forEach((category) => {
              if (category.patches.find(p => p.id === parseInt(patch.dataset.patchId))) {
                clickedPatch = category.patches.find(p => p.id === parseInt(patch.dataset.patchId));
              }
            });
    
            ProductState.addPatch(clickedPatch);
          } else {
            document.querySelector('.cust-info-img-top').style.opacity = 1;
          }
        });
      });
    }
    addPatchEventListeners();
    
    //////////////////////////////////////////////////
    // Letter search (unchanged)
    //////////////////////////////////////////////////
    let SearchState = {
      current: availablePatchesArray.letters,
      search(searchValue) {
        if (searchValue === "") return this.reset();
        this.current = [];
        searchValue.toLowerCase().split('').forEach(letterString => {
          availablePatchesArray.letters.forEach(category => {
            this.current.push(category.patches.filter(letter => letter.value.toLowerCase() === letterString));
          });
        });
    
        const wrap = document.getElementById('allAvailableLetters');
        wrap.innerHTML = "";
        this.current.forEach(category => {
          if (category.length) {
            category.forEach(patch => {
              wrap.innerHTML += `
                <div class="patch-wrapepr">
                  <img src="${patch.image}" data-patch-id="${patch.id}" data-patch-type="letters"
                       class="patch-img-small ${patch.available ? "" : "not-available"}">
                </div>`;
            });
          }
        });
    
        addAllIconPatchesToDOM();
        addPatchEventListeners();
      },
      reset() {
        this.current = availablePatchesArray.letters;
        addAllLetterPatchesToDOM();
        addAllIconPatchesToDOM();
        addPatchEventListeners();
      }
    };
    
    document.getElementById('letterSearch').addEventListener('keyup', (e) => {
      SearchState.search(e.target.value);
    });
    
    //////////////////////////////////////////////////
    // Start flow: hook "Customise" button → open modal at step two
    //////////////////////////////////////////////////
    function resetForNewSession(activeVariantId) {
      // reset state
      ProductState.patches = [];
      ProductState.stateId = Math.floor(Date.now() / 1000);
    
      // clear visuals
      document.getElementById('imposedPatches').innerHTML = '';
      document.querySelector('.cust-info-img-top').style.opacity = 0;
      document.querySelector('.cust-info-img-bottom').style.opacity = 0;
      document.querySelector('.summary-info-wrap').innerHTML = '';
    
      ProductState.initThemeByVariantId(activeVariantId);
      showStepTwoOnly();
    }
    
    const customiseTrigger = document.querySelector('.product-customise');
    if (customiseTrigger) {
      customiseTrigger.addEventListener('click', () => {
        const currentVariantId = getCurrentVariantIdFromForm();
        resetForNewSession(currentVariantId);
        customiseModal.open();
      });
    }
    
    // Also initialise once so the image isn’t blank before first open (uses currently selected)
    (function bootstrapOnce() {
      const currentVariantId = getCurrentVariantIdFromForm();
      ProductState.initThemeByVariantId(currentVariantId);
      showStepTwoOnly();
    })();
    </script>
    