<style>
    .patch-row {
      display: grid;
      grid-template-columns: 1fr 10fr;
      grid-gap: 1rem;
      align-items: center;
      margin-top: 1rem;
    }
    .patch-row img { width: 100%; }
  
    /* Liquid can add this class for patch line-items to hide them */
    .patch-row-to-hide { display: none; }
  
    .quantity.disabled { opacity: .25; pointer-events: none; }
    .quantity.disabled svg { opacity: 0; }
  
    .customised-product-cart-remove-btn {
      display: flex;
      align-items: center;
      opacity: .5;
      margin-left: 1rem;
      padding-left: 1rem;
      cursor: pointer;
    }
    .customised-product-cart-remove-btn.disabled { opacity: .25; transition: 1s; pointer-events: none; }
    .customised-product-cart-remove-btn:hover { opacity: 1; }
    .customised-product-cart-remove-btn svg { height: 1.5rem; width: 1.5rem; }
  
    @media screen and (min-width: 750px) {
      .customised-product-cart-remove-btn { margin: 0.5rem 0 0 1.5rem; }
    }
  
    /* Ensure the cart thumb is a positioning context */
    .cart-item__image-containe,
    .cart-item__image-container { position: relative; }
  
    .patch-imposed-wrapper {
      position: absolute;
      display: flex;
      justify-content: center;
      width: 100%;
      top: 76px; /* overridden inline using saved Y position */
    }
    .patch-imposed-wrapper img { width: .9rem; }
  
    /* If a .patch-row is inserted under a property row, hide the native row */
    .product-option:has(.patch-row) dt,
    .product-option:has(.patch-row) dd { display: none; }
  </style>
  
  <script>
  console.log("[PC Cart] START");
  
  // ------------------------
  // Utilities
  // ------------------------
  function insertAfter(referenceNode, newNode) {
    referenceNode.parentNode.insertBefore(newNode, referenceNode.nextSibling);
  }
  function safeNumber(n) {
    const v = Number(String(n || "").trim());
    return Number.isFinite(v) ? v : 0;
  }
  function normalizeLabel(text) {
    return String(text || "")
      .replace(/[:\s]+/g, "")   // strip colons & spaces
      .toLowerCase();
  }
  
  // Accept both spellings just in case
  const PROP_LABELS = ["customisationid", "customizationid"];
  
  // ------------------------
  // Read localStorage
  // ------------------------
  let storageRaw = localStorage.getItem('productWithPatches');
  if (!storageRaw) {
    console.log('[PC Cart] No "productWithPatches" in localStorage.');
    console.log("[PC Cart] END");
  } else {
    let currentStorage = [];
    try { currentStorage = JSON.parse(storageRaw) || []; }
    catch(e) { console.warn('[PC Cart] Bad JSON in localStorage.', e); currentStorage = []; }
  
    if (!Array.isArray(currentStorage) || currentStorage.length === 0) {
      console.log('[PC Cart] Storage empty.');
      console.log("[PC Cart] END");
    } else {
      // ------------------------
      // Per cart line
      // ------------------------
      const cartItems = document.querySelectorAll('.cart-item');
      if (!cartItems.length) console.warn('[PC Cart] No .cart-item elements found.');
  
      cartItems.forEach((cartItem) => {
        // Find property row whose <dt> label is CustomisationID (colon optional)
        const propRow = Array.from(cartItem.querySelectorAll('.product-option')).find(opt => {
          const dt = opt.querySelector('dt');
          return dt && PROP_LABELS.includes(normalizeLabel(dt.textContent));
        });
        if (!propRow) return; // not a customised base item
  
        const stateIdDD = propRow.querySelector('dd');
        if (!stateIdDD) return;
  
        const stateId = safeNumber(stateIdDD.textContent);
        if (!stateId) return;
  
        // Match saved config
        const currentItem = currentStorage.find(x => safeNumber(x.stateId) === stateId);
        if (!currentItem) return;
  
        // ------------------------
        // Render overlay patches on the line's thumbnail
        // ------------------------
        const thumbWrap =
          cartItem.querySelector('.cart-item__image-container') ||
          cartItem.querySelector('.cart-item__image-containe'); // typo fallback
  
        if (thumbWrap && !thumbWrap.querySelector('.patch-imposed-wrapper')) {
          const patchImposedWrapper = document.createElement('div');
          patchImposedWrapper.className = 'patch-imposed-wrapper';
  
          const posY = currentItem?.position?.y;
          if (posY != null) patchImposedWrapper.style.top = `calc(1% * ${posY})`;
  
          thumbWrap.append(patchImposedWrapper);
  
          // reverse for correct visual order
          [...currentItem.patches].reverse().forEach((patch) => {
            const img = document.createElement('img');
            img.className = 'patch-imposed';
            img.src = patch.image;
            patchImposedWrapper.prepend(img);
          });
        }
  
        // ------------------------
        // Pretty list of patches under the property row
        // ------------------------
        [...currentItem.patches].reverse().forEach((patch) => {
          const patchInList = document.createElement('div');
          patchInList.className = 'patch-row';
          patchInList.innerHTML = `
            <img src="${patch.image}" alt="">
            <div class="patch-title">${patch.title}</div>
          `;
          insertAfter(stateIdDD, patchInList);
        });
  
        // Disable quantity on the base themed line
        const qtyWrap =
          cartItem.querySelector('.quantity') ||
          cartItem.querySelector('[data-quantity]'); // fallback
        if (qtyWrap) qtyWrap.classList.add('disabled');
  
        // ------------------------
        // Replace remove button with our handler (remove patches + base)
        // ------------------------
        const removeHost =
          cartItem.querySelector('cart-remove-button') ||
          cartItem.querySelector('[data-cart-remove]') ||
          cartItem.querySelector('.cart-remove') ||
          cartItem.querySelector('a[href^="/cart/change"]');
  
        if (removeHost) {
          // capture an icon if present
          const svg = removeHost.querySelector('svg')?.cloneNode(true);
          const newDeleteEl = document.createElement('div');
          newDeleteEl.className = 'customised-product-cart-remove-btn';
          if (svg) newDeleteEl.append(svg);
          removeHost.replaceWith(newDeleteEl);
  
          let currentCartItems = [];
          // snapshot current cart for ids/quantities
          fetch(window.Shopify.routes.root + 'cart.js', { method: 'GET', headers: { 'Content-Type': 'application/json' }})
            .then(res => res.json())
            .then(data => { currentCartItems = data.items || []; })
            .catch(() => {});
  
          newDeleteEl.addEventListener('click', () => {
            newDeleteEl.classList.add('disabled');
  
            // 1) Decrement patch quantities
            let updates = {};
            (currentCartItems || []).forEach(item => { updates[item.id] = item.quantity; });
            currentItem.patches.forEach(patch => {
              if (updates[patch.id] > 0) updates[patch.id] -= 1;
            });
  
            fetch(window.Shopify.routes.root + 'cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ updates })
            }).then(() => {
              // 2) Remove base line by matching CustomisationID in properties
              setTimeout(() => {
                fetch(window.Shopify.routes.root + 'cart.js', { method: 'GET', headers: { 'Content-Type': 'application/json' }})
                  .then(res => res.json())
                  .then(data => {
                    const items = data.items || [];
                    const lineIndex = items.findIndex(li => {
                      return li.properties && safeNumber(li.properties.CustomisationID) === stateId;
                    });
                    if (lineIndex >= 0) {
                      return fetch(window.Shopify.routes.root + 'cart/change.js', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ line: lineIndex + 1, quantity: 0 }) // 1-based
                      });
                    }
                  })
                  .finally(() => setTimeout(() => location.reload(), 600));
              }, 700);
            });
          });
        }
      });
  
      // Hide the “Patches” property row (we render a nicer list)
      document.querySelectorAll('.product-option').forEach(option => {
        const txt = option.textContent || "";
        if (txt.toLowerCase().includes('patches')) option.style.display = 'none';
      });
  
      // ------------------------
      // Safety check (optional; left as-is)
      // ------------------------
      if (document.querySelectorAll('.patch-row-to-hide .quantity__input').length) {
        let numberOfPatchesInCart = 0;
        document.querySelectorAll('.patch-row-to-hide .quantity__input').forEach(quantity => {
          numberOfPatchesInCart += Number(quantity.value || 0);
        });
        numberOfPatchesInCart = numberOfPatchesInCart / 2; // drawer duplication
  
        let numberOfCustomPatches = document.querySelectorAll('.patch-title').length;
  
        if (numberOfPatchesInCart !== numberOfCustomPatches) {
          console.warn('[PC Cart] Patch count mismatch — clearing cart for safety.');
          fetch(window.Shopify.routes.root + 'cart/clear.js', {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
          });
          setTimeout(() => { window.location.href = "/"; }, 500);
        }
      }
  
      console.log("[PC Cart] END");
    }
  }
  </script>
  